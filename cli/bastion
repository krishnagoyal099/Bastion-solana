#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
# BASTION - ZK-Powered Anti-MEV Dark Pool on Solana
# Production TUI Suite v1.0.0
# ═══════════════════════════════════════════════════════════════════

BASTION_VERSION="1.0.0"

# Don't use set -e — many subcommands return non-zero legitimately
# (RPC failures, empty gum selections, bc errors, etc.)

# Determine script directory (resolving symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASTION_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
cd "$BASTION_DIR/.."

# Add local bin to PATH
export PATH="$PATH:$HOME/.local/bin"

# Source configuration
if [[ -f "$BASTION_DIR/config/contracts.env" ]]; then
    source "$BASTION_DIR/config/contracts.env"
fi
if [[ -f "$BASTION_DIR/config/networks.env" ]]; then
    source "$BASTION_DIR/config/networks.env"
fi

# Source all libraries from lib/ subdirectory
source "$BASTION_DIR/lib/ui.sh"
source "$BASTION_DIR/lib/network.sh"
source "$BASTION_DIR/lib/solana_tx.sh"
source "$BASTION_DIR/lib/identity.sh"
source "$BASTION_DIR/lib/ledger.sh"
source "$BASTION_DIR/lib/zkproof.sh"
source "$BASTION_DIR/lib/simulation.sh"
source "$BASTION_DIR/lib/whale.sh"
source "$BASTION_DIR/lib/ticker.sh"
source "$BASTION_DIR/lib/arbitrage.sh"
source "$BASTION_DIR/lib/liquidity.sh"

# ═══════════════════════════════════════════════════════════════════
# Initialization
# ═══════════════════════════════════════════════════════════════════

init_bastion() {
    # Initialize ledger
    init_ledger

    # Ensure keys directory exists
    mkdir -p "$BASTION_DIR/../keys"

    # Set default identity if not set
    if [[ ! -f "$HOME/.bastion/.current_identity" ]]; then
        mkdir -p "$HOME/.bastion"
        echo "user" > "$HOME/.bastion/.current_identity"
    fi

    # Auto-detect network from solana config
    detect_network 2>/dev/null || true
}

# ═══════════════════════════════════════════════════════════════════
# Quick Trade — Real Dark Pool Order
# ═══════════════════════════════════════════════════════════════════

quick_trade() {
    clear_screen
    show_banner

    draw_section "Quick Trade via Bastion Dark Pool"

    local side
    side=$(gum choose "BUY SOL" "SELL SOL") || true
    [[ -z "$side" ]] && return

    local amount
    amount=$(gum input --placeholder "Amount (SOL)" --value "10") || true
    [[ -z "$amount" ]] && return

    echo ""
    echo -e "${C_BOLD}Order Summary:${C_RESET}"
    echo -e "  Side:      ${C_CYAN}$side${C_RESET}"
    echo -e "  Amount:    ${C_CYAN}$amount SOL${C_RESET}"
    echo -e "  Route:     ${C_PURPLE}Bastion Dark Pool${C_RESET} (MEV Protected)"
    echo -e "  Network:   ${C_DIM}$CHAIN_NAME${C_RESET}"
    echo ""

    gum confirm "Submit order?" || { echo ""; return; }

    echo ""

    # Generate ZK proof visualization
    local proof_result
    proof_result=$(simulate_zk_proof "$amount" "${side%% *}")

    echo ""

    # Try real on-chain commitment
    local order_side="${side%% *}"
    local commitment_data
    commitment_data=$(do_submit_commitment "$amount" "$order_side" "170.00" 2>/dev/null) || true

    if [[ -n "$commitment_data" ]] && [[ "$commitment_data" != "ERROR:"* ]]; then
        local commitment_hex
        commitment_hex=$(echo "$commitment_data" | python3 -c "import sys,json; print(json.load(sys.stdin).get('commitment_hex','')[:16])" 2>/dev/null) || true
        msg_success "Order committed to Bastion Dark Pool!"
        echo -e "  Commitment: ${C_PURPLE}0x${commitment_hex}...${C_RESET}"
    else
        # Fallback: simulated order
        local tx_hash="bastion_$(openssl rand -hex 16 2>/dev/null || python3 -c "import os; print(os.urandom(16).hex())")"
        msg_success "Order submitted to Bastion Dark Pool!"
        echo -e "  TX: ${C_DIM}$tx_hash${C_RESET}"

        # Log to ledger
        add_transaction "$tx_hash" "order" "$amount" "success" "$(get_current_identity)" '{"side":"'"$order_side"'"}' 2>/dev/null || true
    fi

    echo ""
    gum input --placeholder "Press Enter to continue..." || true
}

# ═══════════════════════════════════════════════════════════════════
# Deposit SOL/USDC into Bastion
# ═══════════════════════════════════════════════════════════════════

deposit_menu() {
    clear_screen
    show_banner

    draw_section "Deposit to Bastion"

    # Show current wallet balance
    local pubkey
    pubkey=$(get_wallet_pubkey 2>/dev/null) || true
    if [[ -n "$pubkey" ]]; then
        local bal
        bal=$(get_sol_balance "$pubkey" 2>/dev/null) || bal="?"
        echo -e "  ${C_BOLD}Wallet:${C_RESET}  ${C_CYAN}${pubkey:0:12}...${pubkey: -8}${C_RESET}"
        echo -e "  ${C_BOLD}Balance:${C_RESET} ${C_CYAN}$bal SOL${C_RESET}"
        echo ""
    else
        msg_warn "No wallet found. Use Identity Manager to create one."
        echo ""
        gum input --placeholder "Press Enter to continue..." || true
        return
    fi

    local asset
    asset=$(gum choose "SOL" "USDC (SPL Token)") || true
    [[ -z "$asset" ]] && return

    local amount
    amount=$(gum input --placeholder "Amount to deposit" --value "1") || true
    [[ -z "$amount" ]] && return

    echo ""
    echo -e "${C_BOLD}Deposit Summary:${C_RESET}"
    echo -e "  Asset:   ${C_CYAN}$asset${C_RESET}"
    echo -e "  Amount:  ${C_CYAN}$amount${C_RESET}"
    echo -e "  From:    ${C_DIM}${pubkey:0:20}...${C_RESET}"
    echo -e "  To:      ${C_PURPLE}Bastion Dark Pool Escrow${C_RESET}"
    echo ""

    gum confirm "Confirm deposit?" || { echo ""; return; }

    echo ""
    msg_info "Submitting deposit transaction..."

    local result
    if [[ "$asset" == "SOL" ]]; then
        result=$(do_deposit_sol "$amount" 2>&1) || true
    else
        result=$(do_deposit_sol "$amount" 2>&1) || true  # TODO: token deposit
    fi

    if [[ -n "$result" ]] && [[ "$result" != "ERROR:"* ]] && echo "$result" | grep -q "^TX:"; then
        local sig="${result#TX:}"
        confirm_tx_display "$sig" "Deposit"
        add_transaction "$sig" "deposit" "$amount" "success" "$(get_current_identity)" '{"asset":"'"$asset"'"}' 2>/dev/null || true
    else
        # Offline/fallback
        local tx_hash="deposit_$(openssl rand -hex 12 2>/dev/null || python3 -c "import os; print(os.urandom(12).hex())")"
        msg_warn "On-chain deposit unavailable (${result#ERROR:})"
        msg_info "Order queued locally. Will submit when network is available."
        echo -e "  Local ID: ${C_DIM}$tx_hash${C_RESET}"
        add_transaction "$tx_hash" "deposit" "$amount" "pending" "$(get_current_identity)" '{"asset":"'"$asset"'","offline":true}' 2>/dev/null || true
    fi

    echo ""
    gum input --placeholder "Press Enter to continue..." || true
}

# ═══════════════════════════════════════════════════════════════════
# Withdraw from Bastion
# ═══════════════════════════════════════════════════════════════════

withdraw_menu() {
    clear_screen
    show_banner

    draw_section "Withdraw from Bastion"

    local pubkey
    pubkey=$(get_wallet_pubkey 2>/dev/null) || true
    if [[ -z "$pubkey" ]]; then
        msg_warn "No wallet found."
        gum input --placeholder "Press Enter to continue..." || true
        return
    fi

    echo -e "  ${C_BOLD}Wallet:${C_RESET}  ${C_CYAN}${pubkey:0:12}...${pubkey: -8}${C_RESET}"
    echo ""

    local asset
    asset=$(gum choose "SOL" "USDC") || true
    [[ -z "$asset" ]] && return

    local amount
    amount=$(gum input --placeholder "Amount to withdraw" --value "1") || true
    [[ -z "$amount" ]] && return

    echo ""
    gum confirm "Withdraw $amount $asset?" || { echo ""; return; }

    echo ""
    msg_info "Submitting withdrawal..."

    local is_sol="true"
    [[ "$asset" != "SOL" ]] && is_sol="false"

    local result
    result=$(do_withdraw "$amount" "$is_sol" 2>&1) || true

    if [[ -n "$result" ]] && echo "$result" | grep -q "^TX:"; then
        local sig="${result#TX:}"
        confirm_tx_display "$sig" "Withdrawal"
        add_transaction "$sig" "withdraw" "$amount" "success" "$(get_current_identity)" '{"asset":"'"$asset"'"}' 2>/dev/null || true
    else
        msg_warn "On-chain withdrawal unavailable (${result#ERROR:})"
        msg_info "Ensure you have funds deposited in the dark pool."
    fi

    echo ""
    gum input --placeholder "Press Enter to continue..." || true
}

# ═══════════════════════════════════════════════════════════════════
# Main Menu
# ═══════════════════════════════════════════════════════════════════

main_menu() {
    while true; do
        clear_screen
        show_banner

        # Get current status
        local identity
        identity=$(get_current_identity 2>/dev/null) || identity="user"
        local status
        status=$(check_connection 2>/dev/null) || status="disconnected"
        local slot
        slot=$(get_block_height 2>/dev/null) || slot="N/A"

        show_status_bar "$CHAIN_NAME" "$status" "$slot" "$identity"

        echo ""
        echo -e "${C_BOLD}${C_WHITE}  Mission Control${C_RESET}"
        echo ""

        local choice
        choice=$(gum choose --cursor.foreground="117" --selected.foreground="114" \
            "🔐  Quick Trade (Bastion Dark Pool)" \
            "💰  Deposit SOL / USDC" \
            "📤  Withdraw" \
            "💧  Liquidity Command Center" \
            "👥  Identity Manager" \
            "📜  Transaction Ledger" \
            "📊  Live Market Ticker" \
            "📉  Arbitrage Scanner" \
            "🐳  Whale Mode (Iceberg Orders)" \
            "⚔️   MEV Attack Simulation" \
            "🔬  ZK Proof Demo" \
            "⚙️   Settings" \
            "🚪  Exit") || true

        # If gum was cancelled (Ctrl+C), treat as continue
        [[ -z "$choice" ]] && continue

        case "$choice" in
            *"Quick Trade"*)
                quick_trade
                ;;
            *"Deposit"*)
                deposit_menu
                ;;
            *"Withdraw"*)
                withdraw_menu
                ;;
            *"Liquidity"*)
                liquidity_menu
                ;;
            *"Identity"*)
                identity_menu
                ;;
            *"Ledger"*)
                ledger_menu
                ;;
            *"Ticker"*)
                ticker_menu
                ;;
            *"Arbitrage"*)
                arbitrage_menu
                ;;
            *"Whale"*)
                whale_menu
                ;;
            *"MEV"*)
                mev_demo
                ;;
            *"ZK Proof"*)
                zk_demo
                ;;
            *"Settings"*)
                settings_menu
                ;;
            *"Exit"*)
                clear_screen
                echo -e "${C_PURPLE}${C_BOLD}"
                echo "  Thanks for using Bastion! ♜"
                echo -e "${C_RESET}"
                exit 0
                ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════
# Settings Menu
# ═══════════════════════════════════════════════════════════════════

settings_menu() {
    while true; do
        clear_screen
        show_banner

        draw_section "Settings"

        echo -e "  ${C_BOLD}Network:${C_RESET}     ${CHAIN_NAME}"
        echo -e "  ${C_BOLD}RPC:${C_RESET}         ${SOLANA_RPC_URL}"
        echo -e "  ${C_BOLD}Identity:${C_RESET}    $(get_current_identity 2>/dev/null || echo user)"
        echo -e "  ${C_BOLD}Version:${C_RESET}     ${BASTION_VERSION}"
        echo ""
        echo -e "  ${C_BOLD}Programs:${C_RESET}"
        echo -e "    ${C_DIM}Pool:  ${BASTION_POOL_PROGRAM}${C_RESET}"
        echo -e "    ${C_DIM}AMM:   ${BASTION_AMM_PROGRAM}${C_RESET}"
        echo -e "  ${C_BOLD}Tokens:${C_RESET}"
        echo -e "    ${C_DIM}USDC:  ${USDC_MINT}${C_RESET}"
        echo -e "    ${C_DIM}WSOL:  ${WSOL_MINT}${C_RESET}"
        echo ""

        local choice
        choice=$(gum choose \
            "Switch Network" \
            "View Program Addresses" \
            "Test Network Connection" \
            "Request Airdrop (devnet/localnet)" \
            "← Back to Main Menu") || true

        [[ -z "$choice" ]] && break

        case "$choice" in
            "Switch Network")
                echo ""
                local network
                network=$(gum choose "localnet" "devnet" "mainnet") || true
                if [[ -n "$network" ]]; then
                    if switch_network "$network"; then
                        msg_success "Switched to $CHAIN_NAME"
                        echo -e "  RPC: ${C_CYAN}$SOLANA_RPC_URL${C_RESET}"
                    else
                        msg_error "Failed to switch network"
                    fi
                    sleep 1
                fi
                ;;
            "View Program Addresses")
                echo ""
                echo -e "${C_BOLD}Program Addresses:${C_RESET}"
                echo -e "  Pool:    ${C_CYAN}$BASTION_POOL_PROGRAM${C_RESET}"
                echo -e "  AMM:     ${C_CYAN}$BASTION_AMM_PROGRAM${C_RESET}"
                echo -e "  USDC:    ${C_CYAN}$USDC_MINT${C_RESET}"
                echo -e "  WSOL:    ${C_CYAN}$WSOL_MINT${C_RESET}"
                echo ""
                gum input --placeholder "Press Enter to continue..." || true
                ;;
            "Test Network Connection")
                echo ""
                msg_info "Testing connection to $SOLANA_RPC_URL..."
                local status
                status=$(check_connection 2>/dev/null) || status="disconnected"
                local slot
                slot=$(get_block_height 2>/dev/null) || slot="N/A"
                if [[ "$status" == "connected" ]]; then
                    msg_success "Connected to Solana ($CHAIN_NAME)"
                    echo -e "  Slot: ${C_CYAN}$slot${C_RESET}"
                    local bal
                    bal=$(get_sol_balance 2>/dev/null) || bal="?"
                    echo -e "  Wallet Balance: ${C_CYAN}$bal SOL${C_RESET}"
                else
                    msg_error "Connection failed"
                    msg_info "Make sure your RPC endpoint is accessible"
                    if [[ "$CHAIN_NAME" == *"localnet"* ]]; then
                        msg_info "Run: solana-test-validator"
                    fi
                fi
                echo ""
                gum input --placeholder "Press Enter to continue..." || true
                ;;
            "Request Airdrop (devnet/localnet)")
                local identity
                identity=$(get_current_identity 2>/dev/null) || identity="user"
                local key_file
                key_file=$(get_identity_key_file "$identity" 2>/dev/null) || true
                local pubkey
                pubkey=$(get_pubkey_from_keypair "$key_file" 2>/dev/null) || true

                if [[ -n "$pubkey" ]]; then
                    msg_info "Requesting 2 SOL airdrop for $identity..."
                    local result
                    result=$(request_airdrop "$pubkey" 2 2>&1) || true
                    if [[ $? -eq 0 ]] && [[ -n "$result" ]]; then
                        msg_success "Airdrop successful! +2 SOL"
                    else
                        msg_error "Airdrop failed (only works on devnet/localnet)"
                    fi
                else
                    msg_error "No keypair found for current identity"
                    msg_info "Use Identity Manager to create a key"
                fi
                echo ""
                gum input --placeholder "Press Enter to continue..." || true
                ;;
            "← Back to Main Menu"|"")
                break
                ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════
# Command Line Interface
# ═══════════════════════════════════════════════════════════════════

show_help() {
    echo -e "${C_BOLD}BASTION${C_RESET} v${BASTION_VERSION} - ZK-Powered Anti-MEV Dark Pool on Solana"
    echo ""
    echo "Usage: bastion [command] [options]"
    echo ""
    echo "Commands:"
    echo "  (none)              Launch interactive TUI"
    echo "  trade               Quick trade interface"
    echo "  deposit [amount]    Deposit SOL to dark pool"
    echo "  withdraw [amount]   Withdraw from dark pool"
    echo "  ticker              Start live market ticker"
    echo "  identity            Manage trading identities"
    echo "  history             View transaction history"
    echo "  demo                Run MEV simulation demo"
    echo ""
    echo "Config:"
    echo "  config set-network <localnet|devnet|mainnet>"
    echo "  config show         Show current configuration"
    echo ""
    echo "Options:"
    echo "  --version, -v       Show version"
    echo "  --help, -h          Show this help message"
    echo "  --offline           Run in offline mode (simulated data)"
    echo ""
    echo "Examples:"
    echo "  bastion                          # Launch TUI"
    echo "  bastion trade                    # Quick trade"
    echo "  bastion config set-network devnet"
    echo "  bastion ticker                   # Live price ticker"
    echo ""
    echo -e "${C_DIM}Install: curl -fsSL https://raw.githubusercontent.com/krishnagoyal099/bastion/main/install-cli.sh | bash${C_RESET}"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════
# Entry Point
# ═══════════════════════════════════════════════════════════════════

main() {
    # Check for gum
    if ! command -v gum &>/dev/null; then
        echo "Error: gum not found."
        echo "Install from https://github.com/charmbracelet/gum"
        echo ""
        echo "Quick install:"
        echo "  brew install gum          # macOS"
        echo "  sudo apt install gum      # Debian/Ubuntu"
        echo "  go install github.com/charmbracelet/gum@latest  # Go"
        exit 1
    fi

    # Initialize
    init_bastion

    # Handle command line arguments
    case "${1:-}" in
        trade)
            quick_trade
            ;;
        deposit)
            if [[ -n "${2:-}" ]]; then
                # Direct deposit mode
                msg_info "Depositing ${2} SOL..."
                do_deposit_sol "$2"
            else
                deposit_menu
            fi
            ;;
        withdraw)
            if [[ -n "${2:-}" ]]; then
                msg_info "Withdrawing ${2} SOL..."
                do_withdraw "$2" "true"
            else
                withdraw_menu
            fi
            ;;
        demo)
            mev_demo
            ;;
        ticker)
            clear_screen
            show_banner
            ticker_menu
            ;;
        identity)
            identity_menu
            ;;
        history)
            ledger_menu
            ;;
        config)
            case "${2:-}" in
                set-network)
                    if [[ -n "${3:-}" ]]; then
                        if switch_network "$3"; then
                            msg_success "Switched to $CHAIN_NAME ($SOLANA_RPC_URL)"
                        else
                            msg_error "Unknown network: $3 (use localnet, devnet, or mainnet)"
                            exit 1
                        fi
                    else
                        msg_error "Usage: bastion config set-network <localnet|devnet|mainnet>"
                        exit 1
                    fi
                    ;;
                show|"")
                    echo -e "${C_BOLD}Bastion Configuration${C_RESET}"
                    echo -e "  Network:  $CHAIN_NAME"
                    echo -e "  RPC:      $SOLANA_RPC_URL"
                    echo -e "  Pool:     $BASTION_POOL_PROGRAM"
                    echo -e "  AMM:      $BASTION_AMM_PROGRAM"
                    echo -e "  Identity: $(get_current_identity 2>/dev/null || echo user)"
                    echo -e "  Version:  $BASTION_VERSION"
                    ;;
                *)
                    msg_error "Unknown config command: $2"
                    echo "Usage: bastion config <set-network|show>"
                    exit 1
                    ;;
            esac
            ;;
        --version|-v)
            echo "bastion $BASTION_VERSION"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            main_menu
            ;;
    esac
}

# Trap Ctrl+C
trap 'echo -e "\n${C_RESET}Exiting..."; exit 0' SIGINT

# Run
main "$@"
